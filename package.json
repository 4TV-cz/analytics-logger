{
  "name": "analytics-logger",
  "version": "1.0.0",
  "private": true,
  "description": "Local proxy + viewer: forwards any HTTP traffic upstream unchanged, logs every request/response to disk, decodes player analytics beacons (Mux, Google Analytics, mParticle) into one row per event, and can replay, rewrite and export the capture.",
  "main": "electron/main.js",
  "scripts": {
    "stop": "node scripts/stop.js",
    "web": "node server.js",
    "web:dev": "node --watch --watch-path=./server.js --watch-path=./src/backend.js --watch-path=./src/scripts server.js --live-reload",
    "electron": "electron .",
    "electron:dev": "node electron/dev.js",
    "electron:release": "electron-builder",
    "test": "node --test test/*.test.js",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "engines": {
    "node": ">=18"
  },
  "build": {
    "appId": "com.deltatre.analytics-logger",
    "productName": "Analytics Logger",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "server.js",
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "AnalyticsLogger-${version}-portable.exe"
    },
    "mac": {
      "icon": "assets/icon.png",
      "target": "dmg",
      "artifactName": "AnalyticsLogger-${version}.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^42.4.1",
    "electron-builder": "^24.13.3"
  }
}
